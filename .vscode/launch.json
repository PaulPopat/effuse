{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LaunchAuth",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/Effuse.Auth/bin/Debug/net10.0/Effuse.Auth.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DATABASE_PROVIDER": "sqlite",
        "SQLITE_FILE": "${workspaceFolder}/Effuse.Auth/database.sqlite"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "LaunchServer",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/Effuse.Server/bin/Debug/net10.0/Effuse.Server.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DATABASE_PROVIDER": "sqlite",
        "SQLITE_FILE": "${workspaceFolder}/Effuse.Server/database.sqlite"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ],
  "compounds": [
    {
      "name": "Launch App",
      "configurations": ["LaunchAuth", "LaunchServer"],
      "preLaunchTask": "build"
    }
  ]
}
