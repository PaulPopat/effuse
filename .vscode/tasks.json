{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "task",
      "type": "process",
      "args": ["build"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/Effuse.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/Effuse.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Reset Database",
      "type": "shell",
      "command": "npm run migrate:latest",
      "options": {
        "cwd": "${workspaceFolder}/Effuse.DatabaseMigration"
      }
    },
    {
      "label": "Run API Tests",
      "type": "shell",
      "command": "npm run test",
      "options": {
        "cwd": "${workspaceFolder}/Effuse.ApiTests"
      },
      "group": {
        "isDefault": true,
        "kind": "test"
      }
    }
  ]
}
